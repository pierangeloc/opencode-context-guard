{
  "name": "opencode-context-guard",
  "version": "0.1.0",
  "description": "Warns, once per threshold, how large an OpenCode session's context has grown and what one more turn on that model costs.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "index.ts",
    "tui.tsx",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context",
    "tokens",
    "cost"
